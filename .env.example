# EscoWear server settings. Copy to .env (never commit .env) and fill in.
# Values containing "$" must be written as "$$" (Docker Compose interpolation).

# --- Required ---
ESCOWEAR_MONGO_URI=          # mongodb+srv://<user>:<password>@<cluster>/escowear-sneaker-import-test
JWT_SECRET=                  # long random string, e.g. `openssl rand -hex 32`
PORT=5000
NODE_ENV=production

# --- Public site ---
ESCOWEAR_PUBLIC_URL=https://escowear.com

# --- Temporary business details (DRAFT; not approved for publication) ---
# Edit client/src/policies/review.json as the shared source for site/email wording.
# Business: EscoWear; market: Ghana; address: To be confirmed.
# Support: support@escowear.com — UNVERIFIED until delivery and replies are tested.
# Payment: Manual Mobile Money confirmation.
# Delivery: Confirmed individually after ordering (no fixed delivery promise).

# --- Manual payment (Mobile Money for the MVP) ---
# Shown in payment-instruction emails and, to the proven order owner only, on
# the order page next to the screenshot upload. Use \n for new lines. Keep it private.
# Example layout: MTN Mobile Money\nNumber: 0XX XXX XXXX\nName: <account name>
# Placeholder/test wording (or 0XX / <slots>) is for isolated testing only: release:check
# rejects it, so checkout cannot open with it.
ESCOWEAR_PAYMENT_INSTRUCTIONS=
# Or set both of these to generate instructions automatically (no code edits).
# Keep the real recipient details in your private .env, not this example.
MOMO_PAYMENT_NUMBER=
MOMO_ACCOUNT_NAME=

# --- Checkout switch ---
# false (default) = the site works but new order requests are refused with
# "Online ordering opens soon". true = open; the server refuses to start open
# unless npm run release:check passes (payment details, email, URL, policies).
ESCOWEAR_CHECKOUT_OPEN=false

# --- Payment proof uploads (IDE-129) ---
# Private directory for customer payment screenshots. In Docker this is fixed to
# the named volume at /app/data/payment-proofs (compose.yaml). Never point it at
# client/public, client/build, server/images or any web root.
# ESCOWEAR_PROOF_UPLOAD_DIR=./data/payment-proofs
# Max upload size in bytes (default 5 MiB, hard ceiling 10 MiB). The Nginx site
# must allow at least this plus ~64 KB (client_max_body_size) — see docs.
# ESCOWEAR_PROOF_MAX_BYTES=5242880
# Retention is NOT decided (owner/legal). 0/unset = keep everything; the purge
# script only reports unless run with --apply.
# ESCOWEAR_PROOF_RETENTION_DAYS=
# Optional ops inbox told (without the image) that a new proof is waiting.
# ESCOWEAR_ADMIN_NOTIFY_EMAIL=

# --- Shop policies (docs/mvp-policies-draft.md) ---
# hidden = not shown; draft = shown with a DRAFT banner (review only, never public);
# published = live. Keep "hidden" until the UK/Ghana legal review is complete.
# Applies to the site at image build time and to emails at runtime.
ESCOWEAR_POLICIES_STATUS=hidden

# --- Email (any SMTP provider; Gmail for the MVP) ---
# none = emails stay queued (nothing sent); smtp = send via the settings below.
EMAIL_TRANSPORT=none         # enable smtp only after approval and delivery/reply tests
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true             # true for port 465; false for 587 (STARTTLS is then required)
SMTP_USER=                   # the sending mailbox, e.g. you@gmail.com
SMTP_PASS=                   # Gmail: a 16-character App Password, NOT your normal password
EMAIL_FROM=                  # e.g. EscoWear <you@gmail.com> (Gmail requires your own address)
EMAIL_REPLY_TO=              # leave unset until the chosen mailbox is verified
# One support mailbox: customers reply to EMAIL_REPLY_TO (or EMAIL_FROM when unset).
# The site shows the same address. Use one mailbox for sending and replies; if
# EMAIL_REPLY_TO differs from EMAIL_FROM, the provider must allow it as a verified alias.
# Proposed EMAIL_REPLY_TO: support@escowear.com (UNVERIFIED; do not activate yet)

# --- Optional tuning (defaults shown) ---
# TRUST_PROXY=loopback, linklocal, uniquelocal
# ORDER_CHECKOUT_ACCESS_TTL_MINUTES=60
# ORDER_TRACKING_ACCESS_TTL_MINUTES=30
# ORDER_TRACKING_CODE_TTL_MINUTES=10
# ORDER_PROOF_ACCESS_TTL_MINUTES=60   # upload capability after a verified tracking code
