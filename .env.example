# EscoWear server settings. Copy to .env (never commit .env) and fill in.
# Values containing "$" must be written as "$$" (Docker Compose interpolation).

# --- Required ---
ESCOWEAR_MONGO_URI=          # mongodb+srv://<user>:<password>@<cluster>/escowear-sneaker-import-test
JWT_SECRET=                  # long random string, e.g. `openssl rand -hex 32`
PORT=5000
NODE_ENV=production

# --- Public site ---
ESCOWEAR_PUBLIC_URL=https://escowear.com

# --- Manual payment (Mobile Money for the MVP) ---
# Shown in payment-instruction emails. Use \n for new lines. Keep it private.
# Example layout: MTN Mobile Money\nNumber: 0XX XXX XXXX\nName: <account name>
ESCOWEAR_PAYMENT_INSTRUCTIONS=

# --- Email (any SMTP provider; Gmail for the MVP) ---
# none = emails stay queued (nothing sent); smtp = send via the settings below.
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true             # true for port 465; false for 587 (STARTTLS is then required)
SMTP_USER=                   # the sending mailbox, e.g. you@gmail.com
SMTP_PASS=                   # Gmail: a 16-character App Password, NOT your normal password
EMAIL_FROM=                  # e.g. EscoWear <you@gmail.com> (Gmail requires your own address)
EMAIL_REPLY_TO=              # optional; where customer replies and screenshots go

# --- Optional tuning (defaults shown) ---
# TRUST_PROXY=loopback, linklocal, uniquelocal
# ORDER_CHECKOUT_ACCESS_TTL_MINUTES=60
# ORDER_TRACKING_ACCESS_TTL_MINUTES=30
# ORDER_TRACKING_CODE_TTL_MINUTES=10
