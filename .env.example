# EscoWear server settings. Copy to .env (never commit .env) and fill in.
# Values containing "$" must be written as "$$" (Docker Compose interpolation).

# --- Required ---
ESCOWEAR_MONGO_URI=          # mongodb+srv://<user>:<password>@<cluster>/escowear-sneaker-import-test
JWT_SECRET=                  # long random string, e.g. `openssl rand -hex 32`
PORT=5000
NODE_ENV=production

# --- Public site ---
ESCOWEAR_PUBLIC_URL=https://escowear.com

# --- Temporary business details (DRAFT; not approved for publication) ---
# Edit client/src/policies/review.json as the shared source for site/email wording.
# Business: EscoWear; market: Ghana; address: To be confirmed.
# Support: support@escowear.com — UNVERIFIED until delivery and replies are tested.
# Payment: Manual Mobile Money confirmation.
# Delivery: Confirmed individually after ordering (no fixed delivery promise).

# --- Manual payment (Mobile Money for the MVP) ---
# Shown in payment-instruction emails. Use \n for new lines. Keep it private.
# Example layout: MTN Mobile Money\nNumber: 0XX XXX XXXX\nName: <account name>
ESCOWEAR_PAYMENT_INSTRUCTIONS=

# --- Shop policies (docs/mvp-policies-draft.md) ---
# hidden = not shown; draft = shown with a DRAFT banner (review only, never public);
# published = live. Keep "hidden" until the UK/Ghana legal review is complete.
# Applies to the site at image build time and to emails at runtime.
ESCOWEAR_POLICIES_STATUS=hidden

# --- Email (any SMTP provider; Gmail for the MVP) ---
# none = emails stay queued (nothing sent); smtp = send via the settings below.
EMAIL_TRANSPORT=none         # enable smtp only after approval and delivery/reply tests
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true             # true for port 465; false for 587 (STARTTLS is then required)
SMTP_USER=                   # the sending mailbox, e.g. you@gmail.com
SMTP_PASS=                   # Gmail: a 16-character App Password, NOT your normal password
EMAIL_FROM=                  # e.g. EscoWear <you@gmail.com> (Gmail requires your own address)
EMAIL_REPLY_TO=              # leave unset until the chosen mailbox is verified
# Proposed EMAIL_REPLY_TO: support@escowear.com (UNVERIFIED; do not activate yet)

# --- Optional tuning (defaults shown) ---
# TRUST_PROXY=loopback, linklocal, uniquelocal
# ORDER_CHECKOUT_ACCESS_TTL_MINUTES=60
# ORDER_TRACKING_ACCESS_TTL_MINUTES=30
# ORDER_TRACKING_CODE_TTL_MINUTES=10
