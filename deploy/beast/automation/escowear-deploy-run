#!/bin/bash
# Root-owned sudo target (/usr/local/sbin) that escowear-deploy may run as ubuntu,
# and only as "check" or "deploy <sha>" (see sudoers.escowear-deploy).
# It refuses outdated commits and repository states that GitHub did not produce,
# then runs scripts/deploy.sh detached so a dropped SSH session cannot interrupt a
# release halfway. The caller sees only "[deploy]" status lines, because GitHub
# Actions logs for this public repository are public; the full log stays on Beast.
set -Eeuo pipefail
umask 077
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

REPO=/home/ubuntu/projects/escowear
STATE=/home/ubuntu/.local/state/escowear/automation
TOKEN_FILE=/home/ubuntu/.config/escowear/github-actions-read.token
RUN_USER=ubuntu
KEEP_LOGS=30

say() { printf '[deploy] %s\n' "$*"; }
refuse() { local code="$1"; shift; printf '[deploy] REFUSED: %s\n' "$*" >&2; exit "$code"; }

[[ "$(id -un)" == "$RUN_USER" ]] || refuse 77 "must run as $RUN_USER"
mode="${1:-}"
sha=""
case "$mode" in
  check) [[ $# -eq 1 ]] || refuse 64 "usage: check | deploy <sha>" ;;
  deploy) [[ $# -eq 2 && "$2" =~ ^[0-9a-f]{40}$ ]] || refuse 64 "usage: check | deploy <40-hex-sha>"; sha="$2" ;;
  *) refuse 64 "usage: check | deploy <sha>" ;;
esac

mkdir -p -m 700 "$STATE/logs"
[[ ! -L "$STATE" && ! -L "$STATE/logs" ]] || refuse 66 "unsafe state directory"
# Held by the detached deployment too, so a second request is refused until it ends.
exec 8>"$STATE/run.lock"
flock -n 8 || refuse 75 "another deployment request is running"

# Repository-local hooks and fsmonitor are not reviewed code; never execute them.
export GIT_CONFIG_COUNT=2 GIT_CONFIG_KEY_0=core.hooksPath GIT_CONFIG_VALUE_0=/dev/null \
  GIT_CONFIG_KEY_1=core.fsmonitor GIT_CONFIG_VALUE_1=false GIT_TERMINAL_PROMPT=0
cd "$REPO"
[[ "$(git branch --show-current)" == master ]] || refuse 66 "checkout is not on master"
[[ -z "$(git status --porcelain)" ]] || refuse 66 "checkout has uncommitted changes"
git fetch --quiet origin master || refuse 69 "could not fetch origin/master"
remote="$(git rev-parse refs/remotes/origin/master)"
# deploy.sh is about to run from this checkout, so it must hold only GitHub commits.
git merge-base --is-ancestor HEAD "$remote" || refuse 66 "local master has commits that are not on GitHub"

args=(--check)
if [[ "$mode" == deploy ]]; then
  [[ "$sha" == "$remote" ]] || refuse 65 "${sha:0:12} is not the current origin/master (${remote:0:12}); outdated commit refused"
  [[ -f "$TOKEN_FILE" && ! -L "$TOKEN_FILE" && "$(stat -c '%U %a' "$TOKEN_FILE")" == "$RUN_USER 600" ]] \
    || refuse 78 "CI-gate token file missing or not mode 600"
  ESCOWEAR_GITHUB_TOKEN="$(<"$TOKEN_FILE")"
  [[ -n "$ESCOWEAR_GITHUB_TOKEN" ]] || refuse 78 "CI-gate token file is empty"
  export ESCOWEAR_GITHUB_TOKEN DEPLOY_EXPECTED_SHA="$sha"
  args=()
fi

log="$STATE/logs/$(date -u +%Y%m%dT%H%M%SZ)-$mode${sha:+-${sha:0:12}}.log"
say "Starting $mode${sha:+ for ${sha:0:12}} (full log on Beast: $log)"
setsid bash "$REPO/scripts/deploy.sh" "${args[@]}" </dev/null >"$log" 2>&1 &
pid=$!
tail -n +1 --pid="$pid" -f "$log" | grep --line-buffered '^\[deploy\]' || true
rc=0
wait "$pid" || rc=$?

find "$STATE/logs" -maxdepth 1 -type f -name '*.log' -printf '%T@ %p\n' \
  | sort -rn | tail -n +"$((KEEP_LOGS + 1))" | cut -d' ' -f2- | xargs -r rm -f --
if [[ $rc -ne 0 ]]; then
  say "FAILED with exit $rc; see $log on Beast"
fi
exit "$rc"
